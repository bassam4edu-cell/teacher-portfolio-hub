      "css": ".ds-criterion{font-family:Tajawal,Arial,sans-serif;font-size:14px;line-height:1.6;display:grid;grid-template-columns:44px minmax(0,1fr) 24px;align-items:center;gap:16px;min-height:112px;padding:20px 8px;width:100%;border:0;border-bottom:1px solid var(--reading-line,#dce1dc);border-radius:0;background:#f0f4f1;color:var(--reading-ink,#284850);text-align:start;box-shadow:none}.ds-number{display:grid;place-items:center;width:44px;height:44px;background:var(--reading-ink,#284850);color:white;border-radius:6px;font-size:20px}.ds-criterion:hover{background:#e9efeb}.ds-criterion:focus-visible{outline:2px solid var(--reading-ink,#284850);outline-offset:4px}",
