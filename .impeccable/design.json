      "name": "Cover primary action",
      "kind": "button",
      "description": "Cover primary action from the public reading surface.",
      "html": "<div class=\"ds-cover\"><button class=\"ds-cover-action\">عناصر الأداء</button></div>",
      "css": ".ds-cover{background:var(--reading-ink,#284850);padding:24px;direction:rtl}.ds-cover-action{font-family:Tajawal,Arial,sans-serif;font-size:14px;line-height:1.6;background:#fff;color:var(--reading-ink,#284850);border:1px solid white;border-radius:7px;padding:10px 18px;min-height:48px;font-size:15px;font-weight:700;transition:background .2s}.ds-cover-action:hover{background:#e8efeb}.ds-cover-action:focus-visible{outline:2px solid white;outline-offset:4px}",
      "refersTo": "button-cover"
    },
    {
      "name": "Public navigation",
      "kind": "nav",
      "description": "Public navigation from the public reading surface.",
      "html": "<nav class=\"ds-nav\" dir=\"rtl\"><a href=\"#\" aria-current=\"page\">الرئيسية</a><a href=\"#about\">عن المعلم</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px}.ds-nav a{font-family:Tajawal,Arial,sans-serif;font-size:14px;line-height:1.6;padding:12px 15px;min-height:44px;color:var(--reading-body,#485e62);border-radius:6px;text-decoration:none}.ds-nav a[aria-current]{background:#eaf0ed;color:var(--reading-ink,#284850);font-weight:700}.ds-nav a:hover{background:#e9efeb}.ds-nav a:focus-visible{outline:2px solid var(--reading-ink,#284850);outline-offset:4px}"
    },
    {
      "name": "About tab",
      "kind": "button",
      "description": "About tab from the public reading surface.",
      "html": "<button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\" dir=\"rtl\">المقدمة</button>",
      "css": ".ds-tab{font-family:Tajawal,Arial,sans-serif;font-size:14px;line-height:1.6;padding:12px 16px;min-height:54px;background:#f3f5f1;color:var(--reading-body,#485e62);border:1px solid transparent;border-radius:6px;transition:background .2s}.ds-tab[aria-selected=true]{background:var(--reading-ink,#284850);color:white;font-weight:700}.ds-tab:hover:not([aria-selected=true]){border-color:#9baea4;background:#eaf0e9}.ds-tab:focus-visible{outline:2px solid var(--reading-ink,#284850);outline-offset:4px}",
      "refersTo": "tab"
    },
